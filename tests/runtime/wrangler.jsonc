{
  "name": "sandtray-runtime-tests",
  "main": "entry.ts",
  "compatibility_date": "2026-09-06",
  "workers_dev": false,
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:8788",
    "RETENTION_POLICY": "{\"version\":\"dev-v1\",\"ttlMs\":28800000,\"purpose\":\"synthetic-testing\"}"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_DO",
        "class_name": "AuthDurableObject"
      },
      {
        "name": "ROOM_DO",
        "class_name": "RoomDurableObject"
      },
      {
        "name": "SCENE_COORDINATOR_DO",
        "class_name": "SceneCoordinatorDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AuthDurableObject",
        "RoomDurableObject",
        "SceneCoordinatorDurableObject"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRIVATE_SCENES",
      "bucket_name": "sandtray-runtime-private"
    },
    {
      "binding": "PRIVATE_ASSETS",
      "bucket_name": "sandtray-runtime-assets"
    }
  ],
  "d1_databases": [
    {
      "binding": "DIRECTORY",
      "database_name": "sandtray-runtime-directory",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../apps/worker/migrations"
    }
  ]
}
